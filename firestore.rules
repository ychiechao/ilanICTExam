rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && accountEnabled() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function accountEnabled() {
      return signedIn() &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled != true);
    }

    function isActiveOwner(uid) {
      return isOwner(uid) && accountEnabled();
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin() ||
        (isActiveOwner(uid) &&
          !request.resource.data.keys().hasAny(["disabled", "disabledAt", "disabledBy"]));
      allow update: if isAdmin() ||
        (isActiveOwner(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["disabled", "disabledAt", "disabledBy"]));
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin() ||
        (isOwner(uid) &&
          !exists(/databases/$(database)/documents/settings/adminBootstrap));
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && docId == "adminBootstrap" &&
        request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/settings/adminBootstrap);
      allow update, delete: if isAdmin();
    }

    match /problems/{problemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if accountEnabled() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /userProblemStats/{statId} {
      allow read: if signedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if accountEnabled() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /leaderboards/{problemId} {
      allow read: if true;
      allow create, update: if accountEnabled();
      allow delete: if isAdmin();
    }
  }
}
