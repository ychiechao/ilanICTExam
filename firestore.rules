rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function accountEnabled() {
      return signedIn() &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("disabled", false) != true);
    }

    function isActiveOwner(uid) {
      return isOwner(uid) && accountEnabled();
    }

    // ---- v3 平台模式（規格第 4 章、第 11 章）----
    // settings/platform 是全站模式的唯一真相來源；找不到文件時視為練習模式。
    function platformMode() {
      return exists(/databases/$(database)/documents/settings/platform)
        ? get(/databases/$(database)/documents/settings/platform).data.get("mode", "practice")
        : "practice";
    }

    // 競賽帳號由 Worker 簽發的自訂 token 帶 claims，不查任何名單文件。
    function isContestAccount() {
      return signedIn() && request.auth.token.get("accountType", "") == "contest";
    }

    function isContestAccountFor(contestId) {
      return isContestAccount() && request.auth.token.get("contestId", "") == contestId;
    }

    // 未設定學校者只能線上測驗，不記錄成績（提交、統計、排行榜一律拒絕寫入）。
    function hasSchool() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("schoolId", "") != "";
    }

    // 練習資料只在練習模式對教師與學生開放；競賽帳號永遠不能碰練習資料。
    function practiceOpen() {
      return platformMode() == "practice" && !isContestAccount();
    }

    function isAdmin() {
      return signedIn() && accountEnabled() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAdmin() &&
        (
          !adminData().keys().hasAny(["role"]) ||
          adminData().role == "super" ||
          !(adminData().role in ["teacher", "school", "student"])
        );
    }

    // 教師：admins 文件 role 為 teacher，且超管已指定學校（沒有學校 = 尚未啟用）。
    function isTeacherAdmin() {
      return isAdmin() &&
        (adminData().role == "teacher" || adminData().role == "school") &&
        (adminData().get("schoolId", "") != "" || adminData().get("schoolIds", []).size() > 0);
    }

    // 教師身分只看 admins 文件（由超管設定學校時建立），教師網域的 Email 本身不算。
    function isTeacher() {
      return isTeacherAdmin();
    }

    function classData(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    function isClassTeacher(classId) {
      return isTeacher() && classData(classId).teacherUid == request.auth.uid;
    }

    function classMemberData(memberId) {
      return get(/databases/$(database)/documents/classMembers/$(memberId)).data;
    }

    function isActiveClassMemberFor(memberId, classId, studentUid) {
      return exists(/databases/$(database)/documents/classMembers/$(memberId)) &&
        classMemberData(memberId).classId == classId &&
        classMemberData(memberId).studentUid == studentUid &&
        classMemberData(memberId).status != "removed";
    }

    function isJoinableClass(classId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        classData(classId).get("joinEnabled", false) == true &&
        classData(classId).get("archived", false) != true;
    }

    function isTeacherEmail() {
      return signedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email.matches(".*@tmail\\.ilc\\.edu\\.tw$");
    }

    function isStudentEmail() {
      return signedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email.matches(".*@smail\\.ilc\\.edu\\.tw$");
    }

    // 使用者自己只能把 role 寫成 student，或（教師網域且已由超管啟用）維持 teacher。
    function ownerRoleAllowed(role) {
      return role == "student" || (role == "teacher" && isTeacherEmail() && isTeacherAdmin());
    }

    match /users/{uid} {
      allow read: if isSuperAdmin() || isOwner(uid);
      allow create: if isSuperAdmin() ||
        (isActiveOwner(uid) &&
          !request.resource.data.keys().hasAny(["disabled", "disabledAt", "disabledBy"]) &&
          (!request.resource.data.keys().hasAny(["role"]) || ownerRoleAllowed(request.resource.data.role)));
      allow update: if isSuperAdmin() ||
        (isActiveOwner(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["disabled", "disabledAt", "disabledBy"]) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]) ||
            ownerRoleAllowed(request.resource.data.role)) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"]) ||
            request.resource.data.status in ["active", "pending"]));
      allow delete: if isSuperAdmin();
    }

    match /admins/{uid} {
      allow read: if isSuperAdmin() || isOwner(uid);
      allow create: if isSuperAdmin() ||
        (isOwner(uid) &&
          !exists(/databases/$(database)/documents/settings/adminBootstrap));
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && docId == "adminBootstrap" &&
        request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/settings/adminBootstrap);
      allow update, delete: if isSuperAdmin();
    }

    // 全站模式：未登入者也要能讀，登入頁才知道現在是不是競賽期間。
    match /settings/platform {
      allow read: if true;
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    // 競賽帳號：只有 Worker 以服務帳號寫入；密碼雜湊存 KV，這裡只有非敏感欄位。
    match /contestAccounts/{accountId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 超管操作紀錄：只能新增，不能修改或刪除。
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 過渡期：正式站仍是 v2.0，刪除使用者時會查這兩個舊集合；升級後移除。
    match /contestRoster/{entryId} {
      allow read, write: if isSuperAdmin();
    }

    match /schoolAccounts/{accountId} {
      allow read, write: if isSuperAdmin();
    }

    match /problems/{problemId} {
      allow read: if isSuperAdmin() || (practiceOpen() && (true));
      allow create, update, delete: if isSuperAdmin();
    }

    match /contests/{contestId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /schools/{schoolId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /classes/{classId} {
      allow read: if isSuperAdmin() || (practiceOpen() && (isSuperAdmin() ||
        (signedIn() && resource.data.get("joinEnabled", false) == true) ||
        (isTeacher() && resource.data.teacherUid == request.auth.uid)));
      allow create: if isSuperAdmin() || (practiceOpen() && (isSuperAdmin() ||
        (
          isTeacher() &&
          request.resource.data.teacherUid == request.auth.uid
        )));
      allow update: if isSuperAdmin() || (practiceOpen() && (isSuperAdmin() ||
        (
          isTeacher() &&
          resource.data.teacherUid == request.auth.uid &&
          request.resource.data.teacherUid == resource.data.teacherUid &&
          request.resource.data.schoolId == resource.data.schoolId
        )));
      allow delete: if isSuperAdmin();
    }

    match /classMembers/{memberId} {
      allow read: if isSuperAdmin() || (practiceOpen() && (isSuperAdmin() ||
        (signedIn() && resource.data.studentUid == request.auth.uid) ||
        isClassTeacher(resource.data.classId)));
      allow create: if isSuperAdmin() || (practiceOpen() && (isSuperAdmin() ||
        (
          accountEnabled() &&
          request.resource.data.studentUid == request.auth.uid &&
          isJoinableClass(request.resource.data.classId)
        )));
      allow update: if isSuperAdmin() || (practiceOpen() && (isSuperAdmin() || isClassTeacher(resource.data.classId)));
      allow delete: if isSuperAdmin();
    }

    match /classSubmissionViews/{viewId} {
      allow read: if isSuperAdmin() || (practiceOpen() && (isSuperAdmin() ||
        (signedIn() && resource.data.studentUid == request.auth.uid) ||
        isClassTeacher(resource.data.classId)));
      allow create, update: if isSuperAdmin() || (practiceOpen() && (accountEnabled() &&
        request.resource.data.studentUid == request.auth.uid &&
        isActiveClassMemberFor(
          request.resource.data.classMemberId,
          request.resource.data.classId,
          request.auth.uid
        ) &&
        request.resource.data.teacherUid == classData(request.resource.data.classId).teacherUid));
      allow delete: if isSuperAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isSuperAdmin() || (practiceOpen() && (isSuperAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid)));
      allow create: if isSuperAdmin() || (practiceOpen() && hasSchool() && (accountEnabled() &&
        request.resource.data.uid == request.auth.uid));
      allow update, delete: if isSuperAdmin();
    }

    match /userProblemStats/{statId} {
      allow read: if isSuperAdmin() || (practiceOpen() && (isSuperAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid)));
      allow create, update: if isSuperAdmin() || (practiceOpen() && hasSchool() && (accountEnabled() &&
        request.resource.data.uid == request.auth.uid));
      allow delete: if isSuperAdmin();
    }

    match /leaderboards/{problemId} {
      allow read: if isSuperAdmin() || (practiceOpen() && (true));
      allow create, update: if isSuperAdmin() || (practiceOpen() && hasSchool() && (isSuperAdmin() || accountEnabled()));
      allow delete: if isSuperAdmin();
    }
  }
}
